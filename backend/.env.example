# debugモードの有効化フラグ
IS_DEBUG=true

# データを格納するディレクトリパス
DATASTORE_DIR=./datastore

# サンプルデータを格納するディレクトリパス
SAMPLE_DATA_DIR=${DATASTORE_DIR}/sample_data

# model を格納しているディレクトリパス
MODELS_DIR=${DATASTORE_DIR}/models

# 統計データを格納しているディレクトリパス
STATISTICAL_DATA_DIR=${DATASTORE_DIR}/statistical_data

# 歩数データや推定結果を格納しているディレクトリパス
VAULT_DIR=${DATASTORE_DIR}/vault

# apiプレフィックス
API_V1_PREFIX=/api/v1

# 識別id生成用のソルト
DATA_ID_SALT=change_me


# メール送信設定（<gmailの例>SMTPサーバー情報）
MAIL_ADDRESS=your-address@gmail.com
MAIL_USERNAME=${MAIL_ADDRESS}
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=${MAIL_ADDRESS}
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com